import("//build/config/ui.gni")

assert(toolkit_views)

# Chromium-free glue between the Rust session and BrowserOps. Also compiled
# and tested outside Chromium by tools/host_harness.
source_set("router") {
  sources = [
    "modal_input_router.cc",
    "modal_input_router.h",
  ]
  public_deps = [ "//components/modal_browser/ffi:modal_browser_ffi" ]
}

# The chrome:// rewrite ChromeContentBrowserClient calls (patches/0010).
# A leaf so //chrome/browser can depend on it.
source_set("url_rewrite") {
  sources = [
    "merlin_url_rewrite.cc",
    "merlin_url_rewrite.h",
  ]
  deps = [
    "//base",
    "//url",
  ]
}

