import("//build/config/ui.gni")
import("//testing/test.gni")

assert(toolkit_views)

# Chromium-free glue between the Rust session and BrowserOps. Also compiled
# and tested outside Chromium by tools/host_harness.
source_set("router") {
  sources = [
    "modal_input_router.cc",
    "modal_input_router.h",
  ]
  public_deps = [ "//components/modal_browser/ffi:modal_browser_ffi" ]
}

# Process rules Chromium asks Merlin about, such as no hidden Tab Search page
# (patches/0048). A leaf so //chrome/browser and its WebUI targets can depend
# on it.
source_set("process_policy") {
  sources = [
    "merlin_process_policy.cc",
    "merlin_process_policy.h",
  ]
  deps = [ "//base" ]
}

# Locating, reading and changing config.toml. Only //base, so its unit tests
# build without the browser.
source_set("config_file") {
  sources = [
    "config_file.cc",
    "config_file.h",
  ]
  public_deps = [ "//base" ]
}

# Unit tests of the parts that need only //base:
#   autoninja -C out/Release chrome/browser/ui/modal_browser:modal_browser_unittests
#   out/Release/modal_browser_unittests
test("modal_browser_unittests") {
  sources = [ "config_file_unittest.cc" ]
  deps = [
    ":config_file",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}

source_set("design_tokens") {
  sources = [ "merlin_design_tokens.h" ]
  public_deps = [ "//skia" ]
}

source_set("theme") {
  public = [ "merlin_theme.h" ]
  sources = [
    "merlin_theme.cc",
    "merlin_theme.h",
  ]
  deps = [
    ":design_tokens",
    "//base",
    "//ui/color",
    "//ui/gfx",
    "//ui/views",
  ]
}

source_set("presentation") {
  sources = [
    "merlin_bubble_header.h",
    "merlin_popup_kit.cc",
    "merlin_popup_kit.h",
  ]
  public_deps = [
    ":design_tokens",
    "//components/vector_icons",
    "//ui/base",
    "//ui/color:color_headers",
    "//ui/views",
  ]
  deps = [
    "//base",
    "//cc/paint",
    "//ui/color",
    "//ui/gfx",
  ]
}

source_set("media_presentation") {
  sources = [
    "merlin_media_controls.cc",
    "merlin_media_controls.h",
  ]
  public_deps = [
    "//base",
    "//components/global_media_controls",
    "//ui/views",
  ]
  deps = [
    ":design_tokens",
    "//chrome/browser/ui/views/controls",
    "//components/vector_icons",
    "//services/media_session/public/mojom",
    "//ui/base",
    "//ui/color",
    "//ui/gfx",
    "//ui/strings",
  ]
}

# Headers used at upstream hook sites. Keep this leaf independent of Views
# implementations to avoid a window-factory/permission-factory dependency cycle.
source_set("shell_headers") {
  sources = [ "merlin_react_window.h", "merlin_shell_bridge.h", "merlin_react_permission_prompt.h", "merlin_react_script_dialog.h", "merlin_react_passwords.h" ]
  public_deps = [ "//base", "//chrome/browser/ui:browser_window_deleter", "//components/permissions", "//content/public/browser", "//components/tabs:public", "//chrome/browser/ui/browser_window" ]
}

