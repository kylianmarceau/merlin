import("//build/config/ui.gni")

assert(toolkit_views)

# Chromium-free glue between the Rust session and BrowserOps. Also compiled
# and tested outside Chromium by tools/host_harness.
source_set("router") {
  sources = [
    "modal_input_router.cc",
    "modal_input_router.h",
  ]
  public_deps = [ "//components/modal_browser/ffi:modal_browser_ffi" ]
}

# The chrome:// rewrite ChromeContentBrowserClient calls (patches/0010).
# A leaf so //chrome/browser can depend on it.
source_set("url_rewrite") {
  sources = [
    "merlin_url_rewrite.cc",
    "merlin_url_rewrite.h",
  ]
  deps = [
    "//base",
    "//url",
  ]
}

# Process rules Chromium asks Merlin about: one process for every start
# page (patches/0047) and no hidden Tab Search page (patches/0048). A leaf
# so //chrome/browser and its WebUI targets can depend on it.
source_set("process_policy") {
  sources = [
    "merlin_process_policy.cc",
    "merlin_process_policy.h",
  ]
  deps = [ "//base" ]
}

source_set("design_tokens") {
  sources = [ "merlin_design_tokens.h" ]
  public_deps = [ "//skia" ]
}

source_set("theme") {
  public = [ "merlin_theme.h" ]
  sources = [
    "merlin_theme.cc",
    "merlin_theme.h",
  ]
  deps = [
    ":design_tokens",
    "//base",
    "//ui/color",
    "//ui/views",
  ]
}

source_set("presentation") {
  sources = [
    "merlin_bubble_header.h",
    "merlin_popup_kit.cc",
