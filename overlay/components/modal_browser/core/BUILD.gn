import("//build/rust/rust_static_library.gni")

# Pure Rust, no third-party dependencies, no unsafe code.
rust_static_library("modal_browser_core") {
  crate_root = "src/lib.rs"
  sources = [
    "src/action.rs",
    "src/command.rs",
    "src/config.rs",
    "src/document.rs",
    "src/editor.rs",
    "src/focus.rs",
    "src/fuzzy.rs",
    "src/hints.rs",
    "src/ipc.rs",
    "src/json.rs",
    "src/key.rs",
    "src/keymap.rs",
    "src/lib.rs",
    "src/mode.rs",
    "src/palette.rs",
    "src/session.rs",
    "src/target.rs",
    "src/toml_lite.rs",
    "src/workspace.rs",
  ]
  visibility = [ "//components/modal_browser/*" ]
}
