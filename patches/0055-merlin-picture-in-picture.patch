+// Merlin: room for the time label as it is now, with every digit as wide
+// as a zero, so the progress bar beside it does not shift each second.
+int TimestampWidth(const views::Label* label) {
+  std::u16string text(label->GetText());
+  for (char16_t& c : text) {
+    if (c >= u'0' && c <= u'9') {
+      c = u'0';
+    }
+  }
+  return gfx::GetStringWidth(text, label->font_list()) + 2;
+}
