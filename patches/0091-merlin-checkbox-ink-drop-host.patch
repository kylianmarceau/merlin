+TEST_F(CheckboxTest, MerlinStyleDisablesInkDropDuringConstruction) {
+  base::ScopedClosureRunner restore_style(
+      base::BindOnce(&merlin_style::SetEnabled, merlin_style::IsEnabled()));
+  merlin_style::SetEnabled(true);
+
+  // MessageBoxView creates its checkbox before attaching it to a widget.
+  TestCheckbox checkbox;
+  EXPECT_EQ(nullptr, InkDrop::Get(&checkbox));
+  const InkDropHost* host = InkDrop::Get(checkbox.ink_drop_view());
+  ASSERT_NE(nullptr, host);
+  EXPECT_EQ(InkDropHost::InkDropMode::OFF, host->GetMode());
+}
