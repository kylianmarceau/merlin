+void AutoPictureInPictureTabHelper::UpdateMerlinPageVisibility(bool seen,
+                                                                 bool enabled) {
+  auto* contents = web_contents();
+  auto* sight = GetMerlinSight(contents);
+  if (!sight) {
+    auto data = std::make_unique<MerlinSight>();
+    sight = data.get();
+    contents->SetUserData(&kMerlinSightKey, std::move(data));
+  }
+  const bool just_hidden = sight->seen && !seen;
+  sight->seen = seen;
+  sight->enabled = enabled;
+
+  auto* manager = PictureInPictureWindowManager::GetInstance();
+  if (seen || !enabled) {
+    // Keep the activation deadline for a request still in flight. Chromium
+    // closes it on arrival if the source page has already returned.
+    if (is_in_auto_picture_in_picture_ &&
+        manager->GetWebContents() == web_contents()) {
+      MaybeExitAutoPictureInPicture();
+    }
+    return;
+  }
+
+  if (!just_hidden || manager->GetWebContents() ||
+      manager->IsPictureInPictureDisabled() || contents->IsFullscreen() ||
+      contents->HasActiveEffectivelyFullscreenVideo() ||
+      contents->IsAudioMuted() || !contents->IsCurrentlyAudible() ||
+      !contents->GetCurrentlyPlayingVideoCount() ||
+      GetCurrentContentSetting() == CONTENT_SETTING_BLOCK) {
+    return;
+  }
+
+  auto* session = content::MediaSession::GetIfExists(contents);
+  if (!session) {
+    return;
+  }
+  using Action = media_session::mojom::MediaSessionAction;
+  const auto actions = session->GetMediaSessionActionsSync();
+  if (!std::ranges::contains(actions, Action::kEnterPictureInPicture)) {
+    return;
+  }
+
+  auto_picture_in_picture_activation_time_ =
+      clock_->NowTicks() + blink::kActivationLifespan;
+  if (std::ranges::contains(actions, Action::kEnterAutoPictureInPicture)) {
+    session->EnterAutoPictureInPicture();
+  } else {
+    session->EnterPictureInPicture();
+  }
+}
