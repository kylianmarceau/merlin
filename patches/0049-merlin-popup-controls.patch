new file mode 100644
index 0000000000..8efbe231dd
--- /dev/null
+++ b/ui/views/merlin_style.cc
@@ -0,0 +1,88 @@
+// Copyright 2026 The Merlin Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/views/merlin_style.h"
+
+#include "cc/paint/paint_flags.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/image/canvas_image_source.h"
+#include "ui/gfx/paint_vector_icon.h"
+#include "ui/views/animation/ink_drop.h"
+#include "ui/views/animation/ink_drop_host.h"
+#include "ui/views/controls/highlight_path_generator.h"
+#include "ui/views/vector_icons.h"
+#include "ui/views/view.h"
+
+namespace views::merlin_style {
+
+namespace {
+
+bool g_enabled = false;
+
+class CheckboxSource : public gfx::CanvasImageSource {
+ public:
+  CheckboxSource(bool checked, SkColor fill, SkColor stroke, SkColor check)
+      : gfx::CanvasImageSource(gfx::Size(kCheckboxSize, kCheckboxSize)),
+        checked_(checked),
+        fill_(fill),
+        stroke_(stroke),
+        check_(check) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    gfx::RectF box(0, 0, kCheckboxSize, kCheckboxSize);
+    if (checked_) {
+      flags.setColor(fill_);
+      canvas->DrawRoundRect(box, kCheckboxRadius, flags);
+      constexpr int kMark = 12;
+      const int offset = (kCheckboxSize - kMark) / 2;
+      canvas->Save();
+      canvas->Translate(gfx::Vector2d(offset, offset));
+      gfx::PaintVectorIcon(canvas, kCheckSmallIcon, kMark, check_);
+      canvas->Restore();
+      return;
+    }
+    constexpr float kStroke = 1.5f;
+    box.Inset(kStroke / 2);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(kStroke);
+    flags.setColor(stroke_);
+    canvas->DrawRoundRect(box, kCheckboxRadius - kStroke / 2, flags);
+  }
+
+ private:
+  const bool checked_;
+  const SkColor fill_;
+  const SkColor stroke_;
+  const SkColor check_;
+};
+
+}  // namespace
+
+bool IsEnabled() {
+  return g_enabled;
+}
+
+void SetEnabled(bool enabled) {
+  g_enabled = enabled;
+}
+
+gfx::ImageSkia CheckboxImage(bool checked,
+                             SkColor fill,
+                             SkColor stroke,
+                             SkColor check) {
+  return gfx::CanvasImageSource::MakeImageSkia<CheckboxSource>(checked, fill,
+                                                               stroke, check);
+}
+
+void UseRoundedFlatHighlight(View* view,
+                             const gfx::Insets& insets,
+                             int radius) {
+  InstallRoundRectHighlightPathGenerator(view, insets, radius);
+  InkDrop::Get(view)->SetMode(InkDropHost::InkDropMode::ON_NO_ANIMATE);
+}
+
+}  // namespace views::merlin_style
