new file mode 100644
index 0000000000..4b8fa85c1e
--- /dev/null
+++ b/ui/views/merlin_style.h
@@ -0,0 +1,62 @@
+// Copyright 2026 The Merlin Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_VIEWS_MERLIN_STYLE_H_
+#define UI_VIEWS_MERLIN_STYLE_H_
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/views/views_export.h"
+
+namespace views {
+class View;
+}
+
+// Merlin's shapes for the shared controls every bubble and dialog is built
+// from: the frame's title and close button, text buttons, switches,
+// checkboxes, radio buttons and list rows. Colors still come from the color
+// pipeline (Merlin's mixer sets them); this file only changes geometry and
+// drops the Material ripples and halos, so a pop-up Chromium never had a
+// Merlin layout for still reads as Merlin's.
+//
+// Off by default, so views_unittests and other embedders keep upstream
+// behavior; the browser turns it on with Merlin's theme
+// (modal_browser::InstallMerlinTheme), which `--modal-browser-upstream-defaults`
+// skips.
+namespace views::merlin_style {
+
+VIEWS_EXPORT bool IsEnabled();
+VIEWS_EXPORT void SetEnabled(bool enabled);
+
+// Metrics, in DIPs.
+inline constexpr int kControlRadius = 8;
+inline constexpr int kRowRadius = 8;
+inline constexpr int kRowInset = 6;
+inline constexpr int kCardRadius = 12;
+inline constexpr int kToggleTrackWidth = 34;
+inline constexpr int kToggleTrackHeight = 20;
+inline constexpr int kToggleThumbInset = 2;
+inline constexpr int kCheckboxSize = 16;
+inline constexpr int kCheckboxRadius = 4;
+inline constexpr int kCloseButtonSize = 24;
+inline constexpr int kCloseIconSize = 14;
+inline constexpr int kTitleFontSize = 14;
+
+// A rounded-square checkbox: filled with `fill` and a `check` mark when
+// checked, a 1.5 DIP `stroke` outline when not.
+VIEWS_EXPORT gfx::ImageSkia CheckboxImage(bool checked,
+                                          SkColor fill,
+                                          SkColor stroke,
+                                          SkColor check);
+
+// Replaces `view`'s circular or full-bleed hover with a rounded rectangle
+// inset by `insets`, without the expanding ripple.
+VIEWS_EXPORT void UseRoundedFlatHighlight(View* view,
+                                          const gfx::Insets& insets,
+                                          int radius);
+
+}  // namespace views::merlin_style
+
+#endif  // UI_VIEWS_MERLIN_STYLE_H_
