+// A page that has no parent ui::Layer (Merlin's React shell places page views
+// itself) draws through a compositor of its own, created each time the page is
+// shown and destroyed each time it is hidden. Both sat on the tab-switch path.
+// Keep one fresh compositor ready for the next page to be shown, and destroy
+// outgoing ones after the switch. A spare is never reused after drawing, so it
+// can't show a previous page's frame.
+constexpr base::TimeDelta kCompositorUpkeepDelay = base::Milliseconds(500);
+bool g_compositor_recycling_disabled = false;
+
+std::unique_ptr<ui::RecyclableCompositorMac>& SpareCompositor() {
+  static base::NoDestructor<std::unique_ptr<ui::RecyclableCompositorMac>>
+      instance;
+  return *instance.get();
+}
+
+std::vector<std::unique_ptr<ui::RecyclableCompositorMac>>&
+RetiredCompositors() {
+  static base::NoDestructor<
+      std::vector<std::unique_ptr<ui::RecyclableCompositorMac>>>
+      instance;
+  return *instance.get();
+}
+
+void CompositorUpkeep() {
+  RetiredCompositors().clear();
+  if (g_compositor_recycling_disabled || SpareCompositor() ||
+      GetBrowserCompositors().empty()) {
+    return;
+  }
+  SpareCompositor() =
+      std::make_unique<ui::RecyclableCompositorMac>(GetContextFactory());
+}
+
+void ScheduleCompositorUpkeep() {
+  static bool scheduled = false;
+  if (scheduled || g_compositor_recycling_disabled) {
+    return;
+  }
+  scheduled = true;
+  GetUIThreadTaskRunner({base::TaskPriority::BEST_EFFORT})
+      ->PostDelayedTask(FROM_HERE, base::BindOnce([] {
+                          scheduled = false;
+                          CompositorUpkeep();
+                        }),
+                        kCompositorUpkeepDelay);
+}
+
+void DropSpareCompositors() {
+  SpareCompositor().reset();
+  RetiredCompositors().clear();
+}
+
 }  // namespace
 
