+++ b/content/public/browser/popup_creation_policy.h
@@ -0,0 +1,22 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CONTENT_PUBLIC_BROWSER_POPUP_CREATION_POLICY_H_
+#define CONTENT_PUBLIC_BROWSER_POPUP_CREATION_POLICY_H_
+#include "base/functional/callback.h"
+#include "content/common/content_export.h"
+#include "content/public/browser/global_routing_id.h"
+class GURL;
+namespace url { class Origin; }
+namespace content {
+class BrowserContext;
+using PopupPolicyResult = base::OnceCallback<void(int, const GURL&)>;
+using PopupCreationPolicy = base::RepeatingCallback<void(GlobalRenderFrameHostId,
+    const url::Origin&, const GURL&, PopupPolicyResult)>;
+// Called after existing popup permissions and activation consumption. This
+// additional asynchronous policy cannot grant a denied window or activation.
+CONTENT_EXPORT void SetPopupCreationPolicy(BrowserContext*, PopupCreationPolicy);
+CONTENT_EXPORT void CheckPopupCreationPolicy(BrowserContext*, GlobalRenderFrameHostId,
+    const url::Origin&, const GURL&, PopupPolicyResult);
+}
+#endif
