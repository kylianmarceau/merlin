+  if (tab_strip_hidden_by_embedder_ == hidden) {
+    return;
+  }
+  tab_strip_hidden_by_embedder_ = hidden;
+  if (GetWidget() && GetWidget()->non_client_view()) {
+    GetWidget()->non_client_view()->InvalidateLayout();
+  }
+  InvalidateLayout();
