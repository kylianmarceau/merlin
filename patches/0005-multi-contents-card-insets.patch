+void MultiContentsView::SetCardInsets(const gfx::Insets& insets,
+                                      float corner_radius) {
+  if (card_insets_ == insets && card_corner_radius_ == corner_radius) {
+    return;
+  }
+  card_insets_ = insets;
+  card_corner_radius_ = corner_radius;
+  UpdateContentsBorderAndOverlay();
+  InvalidateLayout(/*avoid_propagate_during_layout=*/true);
+}
+
+bool MultiContentsView::IsShowingCard() const {
+  return !card_insets_.IsEmpty() && !IsInSplitView();
+}
