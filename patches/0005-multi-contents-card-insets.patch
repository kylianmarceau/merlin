+void MultiContentsView::SetCardInsets(
+    const std::optional<gfx::Insets>& insets,
+    const gfx::RoundedCornersF& corners) {
+  if (card_insets_ == insets && card_corners_ == corners) {
+    return;
+  }
+  card_insets_ = insets;
+  card_corners_ = corners;
+  UpdateContentsBorderAndOverlay();
+  InvalidateLayout(/*avoid_propagate_during_layout=*/true);
+}
+
+bool MultiContentsView::IsShowingCard() const {
+  return card_insets_.has_value() && !IsInSplitView();
+}
