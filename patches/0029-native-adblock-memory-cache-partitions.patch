--- /dev/null
+++ b/third_party/blink/renderer/platform/loader/fetch/browser_resource_cache_policy.cc
@@ -0,0 +1,81 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "third_party/blink/public/platform/browser_resource_cache_policy.h"
+#include "third_party/blink/renderer/platform/loader/fetch/browser_resource_cache_policy.h"
+#include <atomic>
+#include <cstdint>
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "third_party/blink/renderer/platform/wtf/hash_map.h"
+#include "third_party/blink/renderer/platform/wtf/text/string_builder.h"
+#include "third_party/blink/renderer/platform/wtf/text/string_hash.h"
+#include "third_party/blink/renderer/platform/weborigin/kurl.h"
+namespace blink {
+namespace {
+std::atomic<bool> enabled{false};
+std::atomic<uint64_t> epoch{0};
+struct Partitions {
+  base::Lock lock;
+  // Address identities never retain or dereference GC objects. Their
+  // destructor removes entries, including during concurrent sweeping.
+  HashMap<uintptr_t, String> clients GUARDED_BY(lock);
+  uint64_t next GUARDED_BY(lock) = 0;
+};
+Partitions& State() {
+  static base::NoDestructor<Partitions> state;
+  return *state;
+}
+}
+void SetBrowserResourceCachePolicyEnabled(bool value) {
+  enabled.store(value, std::memory_order_relaxed);
+  if (!value) {
+    auto& state = State();
+    base::AutoLock guard(state.lock);
+    state.clients.clear();
+  }
+}
+void InvalidateBrowserResourceCachePolicy() {
+  epoch.fetch_add(1, std::memory_order_relaxed);
+}
+void SetBrowserResourceFetcherPartition(const ResourceFetcher& fetcher,
+                                       const String& partition) {
+  if (!enabled.load(std::memory_order_relaxed) || partition.empty() || partition.length() > 256)
+    return;
+  auto& state = State();
+  base::AutoLock guard(state.lock);
+  StringBuilder key;
+  key.Append("context:");
+  key.Append(partition);
+  state.clients.Set(reinterpret_cast<uintptr_t>(&fetcher), key.ToString());
+}
+String BrowserResourceCacheIdentifier(const ResourceFetcher& fetcher,
+                                      const KURL& url, const String& original) {
+  if (!enabled.load(std::memory_order_relaxed) || !url.ProtocolIsInHttpFamily())
+    return original;
+  auto& state = State();
+  base::AutoLock guard(state.lock);
+  auto entry = state.clients.insert(reinterpret_cast<uintptr_t>(&fetcher), String());
+  if (entry.is_new_entry) {
+    StringBuilder client;
+    client.Append("client:");
+    client.AppendNumber(++state.next);
+    entry.stored_value->value = client.ToString();
+  }
+  StringBuilder key;
+  key.Append("BrowserPolicy:");
+  key.Append(entry.stored_value->value);
+  key.Append(":");
+  key.AppendNumber(epoch.load(std::memory_order_relaxed));
+  key.Append(":");
+  key.Append(original);
+  return key.ToString();
+}
+void RemoveBrowserResourceCachePartition(const ResourceFetcher& fetcher) {
+  if (!enabled.load(std::memory_order_relaxed))
+    return;
+  auto& state = State();
+  base::AutoLock guard(state.lock);
+  state.clients.erase(reinterpret_cast<uintptr_t>(&fetcher));
+}
+}
