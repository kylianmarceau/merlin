+TEST_F(ThrottlingURLLoaderTest, DeferredHeaderUpdatePreservesResponseBody) {
+  base::RunLoop paused;
+  throttle_->set_will_process_response_callback(base::BindLambdaForTesting(
+      [&](URLLoaderThrottle::Delegate*, bool* defer) {
+        *defer = true;
+        paused.Quit();
+      }));
+  CreateLoaderAndStart();
+  mojo::ScopedDataPipeProducerHandle producer;
+  mojo::ScopedDataPipeConsumerHandle consumer;
+  ASSERT_EQ(MOJO_RESULT_OK, mojo::CreateDataPipe(nullptr, producer, consumer));
+  ASSERT_TRUE(mojo::BlockingCopyFromString("preserved response", producer));
+  producer.reset();
+  factory_.NotifyClientOnReceiveResponse(std::move(consumer));
+  paused.Run();
+  EXPECT_EQ(0u, client_.on_received_response_called());
+  auto head = network::mojom::URLResponseHead::New();
+  head->mime_type = "text/html";
+  throttle_->delegate()->UpdateDeferredResponseHead(std::move(head), {});
+  throttle_->delegate()->Resume();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1u, client_.on_received_response_called());
+  EXPECT_EQ("text/html", client_.response_mime());
+  std::string body;
+  ASSERT_TRUE(mojo::BlockingCopyToString(client_.TakeResponseBody(), &body));
+  EXPECT_EQ("preserved response", body);
+}
