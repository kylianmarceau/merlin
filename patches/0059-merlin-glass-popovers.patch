diff --git a/ui/views/merlin_style_mac.mm b/ui/views/merlin_style_mac.mm
new file mode 100644
--- /dev/null
+++ b/ui/views/merlin_style_mac.mm
@@ -0,0 +1,152 @@
+// Copyright 2026 The Merlin Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/views/merlin_style.h"
+
+#import <AppKit/AppKit.h>
+
+#include <cmath>
+
+#include "base/logging.h"
+#include "skia/ext/skia_utils_mac.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkCanvas.h"
+#include "third_party/skia/include/core/SkPaint.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/widget/widget.h"
+
+// The system blur behind a pop-up's content. AppKit sorts effect views below
+// the compositor's view (native_widget_ns_window_bridge.mm), so the pop-up
+// paints its tint and contents over it. Clicks pass through to the widget.
+@interface MerlinPopoverGlassView : NSVisualEffectView {
+ @public
+  // What the mask was last drawn for.
+  SkPath _shape;
+  NSSize _size;
+  CGFloat _scale;
+  BOOL _dark;
+}
+@end
+
+@implementation MerlinPopoverGlassView
+- (NSView*)hitTest:(NSPoint)point {
+  return nil;
+}
+@end
+
+namespace views::merlin_style {
+
+namespace {
+
+NSWindow* GlassWindow(const Widget* widget) {
+  if (!IsEnabled() || !widget ||
+      GetPopoverTransparency() == PopoverTransparency::kSolid) {
+    return nil;
+  }
+  // Translucent widgets only (their windows turn non-opaque once the
+  // compositor is attached). Nil for windows in another process (app shims):
+  // they keep their panel.
+  const ui::Layer* layer = widget->GetLayer();
+  if (!layer || layer->fills_bounds_opaquely()) {
+    return nil;
+  }
+  NSWindow* window = widget->GetNativeWindow().GetNativeNSWindow();
+  if (!window) {
+    return nil;
+  }
+  return window;
+}
+
+MerlinPopoverGlassView* FindGlass(NSView* content) {
+  for (NSView* view in content.subviews) {
+    if ([view isKindOfClass:[MerlinPopoverGlassView class]]) {
+      return static_cast<MerlinPopoverGlassView*>(view);
+    }
+  }
+  return nil;
+}
+
+}  // namespace
+
+bool HasPopoverGlass(const Widget* widget) {
+  return GlassWindow(widget) != nil;
+}
+
+void UpdatePopoverGlass(Widget* widget, const SkPath& shape, bool dark) {
+  NSWindow* window = GlassWindow(widget);
+  if (!window) {
+    return;
+  }
+  NSView* content = window.contentView;
+  MerlinPopoverGlassView* glass = FindGlass(content);
+  if (!glass) {
+    glass = [[MerlinPopoverGlassView alloc] initWithFrame:content.bounds];
+    glass.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    glass.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+    glass.material = NSVisualEffectMaterialPopover;
+    // Frosted even while another window is key, as pop-ups often are.
+    glass.state = NSVisualEffectStateActive;
+    [content addSubview:glass positioned:NSWindowBelow relativeTo:nil];
+    VLOG(1) << "Merlin glass behind window " << window.windowNumber
+            << ", subviews " << content.subviews.count;
+  }
+
+  const NSSize size = content.bounds.size;
+  const CGFloat scale = window.backingScaleFactor;
+  if (glass.maskImage && glass->_shape == shape &&
+      NSEqualSizes(glass->_size, size) && glass->_scale == scale &&
+      glass->_dark == dark) {
+    return;
+  }
+  glass->_shape = shape;
+  glass->_size = size;
+  glass->_scale = scale;
+  glass->_dark = dark;
+  glass.appearance = [NSAppearance
+      appearanceNamed:dark ? NSAppearanceNameDarkAqua : NSAppearanceNameAqua];
+
+  // The mask is the pop-up's outline, drawn at the screen's resolution so its
+  // rounded corners and arrow are smooth.
+  const int width = std::ceil(size.width * scale);
+  const int height = std::ceil(size.height * scale);
+  if (width <= 0 || height <= 0) {
+    return;
+  }
+  SkBitmap bitmap;
+  bitmap.allocN32Pixels(width, height);
+  bitmap.eraseColor(SK_ColorTRANSPARENT);
+  SkCanvas canvas(bitmap);
+  canvas.scale(scale, scale);
+  SkPaint paint;
+  paint.setAntiAlias(true);
+  paint.setColor(SK_ColorBLACK);
+  canvas.drawPath(shape, paint);
+  NSImage* mask = skia::SkBitmapToNSImage(bitmap);
+  mask.size = size;
+  glass.maskImage = mask;
+  [window invalidateShadow];
+}
+
+static NSWindow* WidgetWindow(const Widget* widget) {
+  return widget ? widget->GetNativeWindow().GetNativeNSWindow() : nil;
+}
+
+void RemovePopoverGlass(Widget* widget) {
+  NSWindow* window = WidgetWindow(widget);
+  MerlinPopoverGlassView* glass = window ? FindGlass(window.contentView) : nil;
+  if (!glass) {
+    return;
+  }
+  [glass removeFromSuperview];
+  [window invalidateShadow];
+}
+
+bool HasPopoverGlassViewForTesting(const Widget* widget) {
+  NSWindow* window = WidgetWindow(widget);
+  return window && FindGlass(window.contentView);
+}
+
+}  // namespace views::merlin_style
