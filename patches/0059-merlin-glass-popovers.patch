+void SetPopoverTransparency(PopoverTransparency transparency) {
+  g_transparency = transparency;
+}
+
+PopoverTransparency GetPopoverTransparency() {
+  return g_transparency;
+}
+
+SkColor PopoverGlassTint(SkColor color) {
+  // The system material already greys and blurs the page behind, as in Dia;
+  // the tint only warms it toward Merlin's panel colour. The more of it, the
+  // less of the page shows.
+  const bool dark = color_utils::IsDark(color);
+  switch (g_transparency) {
+    case PopoverTransparency::kSolid:
+      return color;
+    case PopoverTransparency::kLow:
+      return SkColorSetA(color, dark ? 0x8C : 0x99);
+    case PopoverTransparency::kMedium:
+      return SkColorSetA(color, dark ? 0x38 : 0x47);
+    case PopoverTransparency::kHigh:
+      return SkColorSetA(color, dark ? 0x0D : 0x14);
+  }
+}
+
+void PaintPopoverGlassEdge(gfx::Canvas* canvas,
+                           const SkPath& shape,
+                           SkColor surface) {
+  gfx::ScopedCanvas scoped(canvas);
+  canvas->ClipPath(shape, /*do_anti_alias=*/true);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  // Twice the width, half of it clipped away: a hairline just inside.
+  flags.setStrokeWidth(2);
+  flags.setColor(color_utils::IsDark(surface)
+                     ? SkColorSetA(SK_ColorWHITE, 0x26)
+                     : SkColorSetA(SK_ColorBLACK, 0x14));
+  canvas->DrawPath(shape, flags);
+}
+
+#if !BUILDFLAG(IS_MAC)
+bool HasPopoverGlass(const Widget* widget) {
+  return false;
+}
+
+void UpdatePopoverGlass(Widget* widget, const SkPath& shape, bool dark) {}
+
+void RemovePopoverGlass(Widget* widget) {}
+
+bool HasPopoverGlassViewForTesting(const Widget* widget) {
+  return false;
+}
+#endif
+
 }  // namespace views::merlin_style
