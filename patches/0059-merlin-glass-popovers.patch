+// Merlin: whether `border`'s pop-up shows frosted glass. Only where the
+// window server draws the shadow: the panel is then the whole window, and the
+// blur can sit behind it.
+bool UsesGlass(const BubbleBorder& border, const View& view) {
+  return border.shadow() == BubbleBorder::NO_SHADOW &&
+         merlin_style::HasPopoverGlass(view.GetWidget());
+}
+
+// Merlin: the pop-up's outline, the client area plus the visible arrow (at
+// `arrow_rect` in screen coordinates, if any), in `view`'s coordinates.
+SkPath GetGlassShape(const BubbleBorder& border,
+                     const View& view,
+                     std::optional<gfx::Rect> arrow_rect) {
+  gfx::RectF bounds(view.GetLocalBounds());
+  bounds.Inset(gfx::InsetsF(border.GetInsets()));
+  SkPath shape =
+      SkPath::RRect(SkRRect(gfx::RRectF(bounds, border.rounded_corners())));
+  if (!arrow_rect) {
+    return shape;
+  }
+  gfx::Point arrow_origin = arrow_rect->origin();
+  View::ConvertPointFromScreen(&view, &arrow_origin);
+  const SkPath arrow = GetVisibleArrowPath(
+      border.arrow(), gfx::Rect(arrow_origin, arrow_rect->size()),
+      BubbleArrowPart::kFill);
+  return Op(shape, arrow, kUnion_SkPathOp).value_or(shape);
+}
