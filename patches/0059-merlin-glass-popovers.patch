+// Frosted glass, as in macOS and Dia popovers: the system blur behind a
+// pop-up window (bubbles, menus, the address card) under a translucent tint
+// of the pop-up's own colour, with a hairline at its edge.
+
+// How much of the page shows through. kSolid turns glass off: pop-ups keep
+// one flat colour, as before they were frosted. Set from Merlin's config
+// (`popup_transparency`); kMedium by default.
+enum class PopoverTransparency { kSolid, kLow, kMedium, kHigh };
+VIEWS_EXPORT void SetPopoverTransparency(PopoverTransparency transparency);
+VIEWS_EXPORT PopoverTransparency GetPopoverTransparency();
+
+// Whether `widget` shows glass: Merlin's style is on, transparency is not
+// kSolid, the platform has a
+// system blur (macOS) and the widget's window is translucent and in process.
+// Pop-ups that return false keep their opaque panel.
+VIEWS_EXPORT bool HasPopoverGlass(const Widget* widget);
+
+// `color`, a pop-up's panel colour, as the tint painted over the glass.
+VIEWS_EXPORT SkColor PopoverGlassTint(SkColor color);
+
+// Puts the blur behind `widget`, clipped to `shape` (DIPs, in the widget's
+// coordinates), in the dark or light material. Cheap when nothing changed,
+// so pop-ups call it each time they paint their panel.
+VIEWS_EXPORT void UpdatePopoverGlass(Widget* widget,
+                                     const SkPath& shape,
+                                     bool dark);
+
+// Takes the blur away from `widget`, if it has one. For pop-ups whose window
+// outlives a change to kSolid, which then paint an opaque panel instead.
+VIEWS_EXPORT void RemovePopoverGlass(Widget* widget);
+
+// Whether `widget`'s window holds the blur view, whatever the setting.
+VIEWS_EXPORT bool HasPopoverGlassViewForTesting(const Widget* widget);
+
+// The 1 DIP hairline just inside `shape` that gives glass a crisp edge, for
+// a panel of colour `surface`.
+VIEWS_EXPORT void PaintPopoverGlassEdge(gfx::Canvas* canvas,
+                                        const SkPath& shape,
+                                        SkColor surface);
+
 }  // namespace views::merlin_style
 
 #endif  // UI_VIEWS_MERLIN_STYLE_H_
