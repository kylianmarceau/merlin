+views::View* GetMerlinPopupAnchorView(const views::View* in_window) {
+  views::Widget* widget =
+      in_window ? const_cast<views::View*>(in_window)->GetWidget() : nullptr;
+  widget = widget ? widget->GetTopLevelWidget() : nullptr;
+  if (!widget) {
+    return nullptr;
+  }
+  using views::merlin_style::kPopoverPlacementKey;
+  using views::merlin_style::PopoverPlacement;
+  const auto context = views::ElementTrackerViews::GetContextForWidget(widget);
+  for (views::View* view :
+       views::ElementTrackerViews::GetInstance()->GetAllMatchingViews(
+           kLocationIconElementId, context, /*require_visible=*/true)) {
+    if (view->IsDrawn() && view->GetProperty(kPopoverPlacementKey) ==
+                               PopoverPlacement::kTowardMiddle) {
+      return view;
+    }
+  }
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForNativeWindow(widget->GetNativeWindow());
+  views::View* toolbar = browser_view ? browser_view->toolbar() : nullptr;
+  if (toolbar && toolbar->IsDrawn() &&
+      toolbar->GetProperty(kPopoverPlacementKey) ==
+          PopoverPlacement::kCentered) {
+    return toolbar;
+  }
+  return nullptr;
+}
+
 }  // namespace bubble_anchor_util
