+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_PUBLIC_RENDERER_SERVICE_WORKER_CONTROLLER_OBSERVER_H_
+#define CONTENT_PUBLIC_RENDERER_SERVICE_WORKER_CONTROLLER_OBSERVER_H_
+
+#include "content/common/content_export.h"
+#include "third_party/blink/public/common/tokens/tokens.h"
+
+namespace content {
+
+// Called on the renderer main thread when a frame document's service worker
+// controller changes after commit (for example clients.claim() or loss of
+// control). `controlled` is true when a controller with a fetch handler
+// intercepts the document's subresource requests.
+using ServiceWorkerControllerObserver =
+    void (*)(const blink::LocalFrameToken& frame, bool controlled);
+
+// Set once, on the renderer main thread, before frames are created.
+CONTENT_EXPORT void SetServiceWorkerControllerObserver(
+    ServiceWorkerControllerObserver observer);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_RENDERER_SERVICE_WORKER_CONTROLLER_OBSERVER_H_
