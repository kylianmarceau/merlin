+
+#if BUILDFLAG(IS_MAC)
+void ShowInstalledExtensionDialog(
+    gfx::NativeWindow parent,
+    const extensions::ExtensionId& extension_id,
+    std::unique_ptr<ui::DialogModel> dialog_model) {
+  if (!views::merlin_style::IsEnabled()) {
+    ShowDialog(parent, extension_id, std::move(dialog_model));
+    return;
+  }
+
+  const std::vector<extensions::ExtensionId> extension_ids{extension_id};
+  if (auto* container = GetVisibleDialogContainer(parent, extension_ids)) {
+    ShowDialog(container, extension_ids, std::move(dialog_model));
+    return;
+  }
+
+  // The shell hides the native toolbar, so the notice is a window modal.
+  // Keep the dialog model and let the body show the shared glass frame.
+  auto dialog = views::BubbleDialogModelHost::CreateModal(
+      std::move(dialog_model), ui::mojom::ModalType::kWindow);
+  auto* scroll_view =
+      views::AsViewClass<views::ScrollView>(dialog->GetContentsView());
+  if (scroll_view) {
+    scroll_view->SetBackgroundColor(std::nullopt);
+  }
+  constrained_window::CreateBrowserModalDialogViews(std::move(dialog), parent)
+      ->Show();
+}
+#endif
 
