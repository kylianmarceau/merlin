+// Merlin draws the active tab as a detached pill, the shape Chromium already
+// uses for hover and selection, instead of the outline that joins the
+// toolbar. --modal-browser-upstream-defaults keeps Chromium's shape.
+bool UseDetachedActiveTab() {
+  static const bool detached = !base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "modal-browser-upstream-defaults");
+  return detached;
+}
