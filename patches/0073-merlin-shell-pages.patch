 void ShowSettings(BrowserWindowInterface* browser) {
+#if BUILDFLAG(IS_MAC)
+  // Merlin's Settings (⌘, the app menu, extensions) are part of its shell;
+  // Chromium's settings pages stay for the advanced sections it links to.
+  if (modal_browser::OpenShellPanel(browser, "settings")) {
+    return;
+  }
+#endif
   ShowSettingsSubPage(browser, std::string());
 }
 
