+bool ThrottlingURLLoader::UpdateDeferredRequest(const GURL& url,
+                                                bool skip_service_worker) {
+  if (!start_info_ || loader_completed_ || !url.SchemeIsHTTPOrHTTPS()) return false;
+  if (deferred_stage_ == DEFERRED_START) {
+    const auto& previous = start_info_->url_request.url;
+    if (!url::Origin::Create(previous).IsSameOriginWith(url)) return false;
+    if (url != previous) {
+      if (!throttle_will_start_redirect_url_.is_empty() && throttle_will_start_redirect_url_ != url) return false;
+      throttle_will_start_redirect_url_ = url;
+    }
+  } else if (deferred_stage_ == DEFERRED_REDIRECT && redirect_info_) {
+    const auto& previous = redirect_info_->redirect_info.new_url;
+    if (!url::Origin::Create(previous).IsSameOriginWith(url)) return false;
+    if (url != previous) {
+      if (!throttle_will_redirect_redirect_url_.is_empty() && throttle_will_redirect_redirect_url_ != url) return false;
+      throttle_will_redirect_redirect_url_ = url;
+    }
+    // Restart through the same factory so controller service workers need not
+    // implement URLLoader::FollowRedirect with a replacement URL.
+    restart_after_policy_redirect_ |= skip_service_worker || url != previous;
+  } else return false;
+  start_info_->url_request.skip_service_worker |= skip_service_worker;
+  return true;
+}
