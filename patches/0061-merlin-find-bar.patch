+// Merlin's find bar: a slim frosted bar centred under the toolbar, with key
+// hints in place of Chromium's arrow and close buttons.
+constexpr int kMerlinBarWidth = 420;
+constexpr int kMerlinBarHeight = 36;
+constexpr int kMerlinBarRadius = 12;
+// Room around the bar for its drawn shadow.
+constexpr int kMerlinShadowMargin = 14;
+constexpr int kMerlinHintHeight = 20;
+constexpr int kMerlinHintPadding = 6;
+constexpr int kMerlinHintRadius = 5;
+
+// The bar's panel: frosted glass under a tint of the pop-up colour, like
+// Merlin's other pop-ups, or that colour flat when pop-ups are solid.
+class MerlinFindBarBackground : public views::Background {
+ public:
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    views::Widget* widget = view->GetWidget();
+    const SkColor panel =
+        view->GetColorProvider()->GetColor(ui::kColorBubbleBackground);
+    const bool dark = color_utils::IsDark(panel);
+    const SkPath shape = SkPath::RRect(
+        SkRRect::MakeRectXY(gfx::RectToSkRect(view->GetContentsBounds()),
+                            kMerlinBarRadius, kMerlinBarRadius));
+    const bool glass = views::merlin_style::HasPopoverGlass(widget);
+    if (!glass) {
+      // The bar keeps its window between uses, so glass from before a switch
+      // to solid would show around it.
+      views::merlin_style::RemovePopoverGlass(widget);
+    }
+    {
+      // The shadow, kept outside the bar so it does not darken the glass.
+      gfx::ScopedCanvas scoped(canvas);
+      canvas->sk_canvas()->clipPath(shape, SkClipOp::kDifference,
+                                    /*doAntiAlias=*/true);
+      const SkColor shadow = dark ? SkColorSetA(SK_ColorBLACK, 0x59)
+                                  : SkColorSetARGB(0x24, 0x28, 0x1E, 0x0A);
+      gfx::ShadowValues shadows = {
+          gfx::ShadowValue(gfx::Vector2d(0, 6), 22, shadow),
+          gfx::ShadowValue(gfx::Vector2d(0, 1), 3,
+                           SkColorSetA(shadow, SkColorGetA(shadow) / 2)),
+      };
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(panel);
+      flags.setLooper(gfx::CreateShadowDrawLooper(shadows));
+      canvas->DrawPath(shape, flags);
+    }
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(glass ? views::merlin_style::PopoverGlassTint(panel)
+                        : panel);
+    canvas->DrawPath(shape, fill);
+    views::merlin_style::PaintPopoverGlassEdge(canvas, shape, panel);
+    if (glass) {
+      gfx::Point origin;
+      views::View::ConvertPointToWidget(view, &origin);
+      views::merlin_style::UpdatePopoverGlass(
+          widget, shape.makeOffset(origin.x(), origin.y()), dark);
+    }
+  }
+};
+
+// A key hint ("esc") that also works as a button for the mouse. Not in the
+// focus order: the keys it names are the keyboard's way to the same action.
+class MerlinFindKeyHint : public views::Button {
+  METADATA_HEADER(MerlinFindKeyHint, views::Button)
+
+ public:
+  MerlinFindKeyHint(std::u16string text,
+                    std::u16string tooltip,
+                    PressedCallback callback)
+      : views::Button(std::move(callback)),
+        text_(std::move(text)),
+        font_list_(gfx::FontList().DeriveWithSizeDelta(-2)) {
+    GetViewAccessibility().SetName(tooltip);
+    SetTooltipText(tooltip);
+    SetFocusBehavior(FocusBehavior::NEVER);
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::OFF);
+  }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(
+        gfx::GetStringWidth(text_, font_list_) + 2 * kMerlinHintPadding,
+        kMerlinHintHeight);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    const bool hot = GetEnabled() &&
+                     (GetState() == STATE_HOVERED || GetState() == STATE_PRESSED);
+    // Fills are tints of the text colour, as on Merlin's other glass.
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(colors->GetColor(hot ? ui::kColorButtonBackgroundProminent
+                                       : ui::kColorButtonBackground));
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), kMerlinHintRadius,
+                          fill);
+    SkColor text = colors->GetColor(hot ? ui::kColorSysOnSurface
+                                        : ui::kColorSysOnSurfaceSubtle);
+    if (!GetEnabled()) {
+      text = SkColorSetA(text, 0x66);
+    }
+    canvas->DrawStringRectWithFlags(text_, font_list_, text, GetLocalBounds(),
+                                    gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+
+  void StateChanged(ButtonState old_state) override { SchedulePaint(); }
+
+ private:
+  const std::u16string text_;
+  const gfx::FontList font_list_;
+};
+
+BEGIN_METADATA(MerlinFindKeyHint)
+END_METADATA
+
 }  // namespace
 
