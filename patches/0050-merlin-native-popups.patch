+constexpr int kMerlinGroupMargin = 2;
+
+void UseMerlinRowGroup(views::View* container) {
+  container->SetProperty(
+      views::kMarginsKey,
+      gfx::Insets::VH(0, kMerlinGroupMargin));
+  container->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(2, 0)));
+}
+
+// Replaces `container`'s contents with a hairline inset from the edges.
+void SetMerlinHairline(views::View* container) {
+  container->RemoveAllChildViews();
+  container->SetBorder(nullptr);
+  container->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical))
+      ->set_cross_axis_alignment(
+          views::BoxLayout::CrossAxisAlignment::kStretch);
+  container->AddChildView(
