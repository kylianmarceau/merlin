+// found in the LICENSE file.
+#ifndef THIRD_PARTY_BLINK_PUBLIC_WEB_WEB_SCRIPT_EXECUTION_POLICY_H_
+#define THIRD_PARTY_BLINK_PUBLIC_WEB_WEB_SCRIPT_EXECUTION_POLICY_H_
+#include "third_party/blink/public/platform/web_common.h"
+namespace blink {
+class WebLocalFrame;
+// Reads the page-script policy, including sandbox and content settings. This
+// does not grant execution or apply privileged isolated-world exceptions.
+BLINK_EXPORT bool IsScriptExecutionAllowed(const WebLocalFrame& frame);
+}
