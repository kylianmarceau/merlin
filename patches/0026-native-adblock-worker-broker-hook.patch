@@ -0,0 +1,24 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CONTENT_PUBLIC_BROWSER_WORKER_INTERFACE_BINDERS_H_
+#define CONTENT_PUBLIC_BROWSER_WORKER_INTERFACE_BINDERS_H_
+#include "base/functional/callback.h"
+#include "content/common/content_export.h"
+namespace mojo { class BinderMap; }
+namespace url { class Origin; }
+namespace content {
+class BrowserContext;
+class RenderFrameHost;
+// Installed at embedder startup, called on UI while the worker's binder map is
+// populated. Origin and ancestor are derived from browser-owned worker state.
+// The ancestor is null for shared workers and detached dedicated workers.
+using WorkerInterfaceBinderRegistration = base::RepeatingCallback<void(
+    BrowserContext*, const url::Origin&, RenderFrameHost*, mojo::BinderMap*)>;
+CONTENT_EXPORT void SetWorkerInterfaceBinderRegistration(
+    WorkerInterfaceBinderRegistration registration);
+CONTENT_EXPORT void PopulateEmbedderWorkerInterfaceBinders(
+    BrowserContext* context, const url::Origin& origin, RenderFrameHost* ancestor,
+    mojo::BinderMap* map);
+}  // namespace content
+#endif
diff --git a/content/public/browser/worker_interface_binders.cc b/content/public/browser/worker_interface_binders.cc
new file mode 100644
--- /dev/null
+++ b/content/public/browser/worker_interface_binders.cc
@@ -0,0 +1,26 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "content/public/browser/worker_interface_binders.h"
+#include <utility>
+#include "base/no_destructor.h"
+#include "content/public/browser/browser_thread.h"
+namespace content {
+namespace {
+WorkerInterfaceBinderRegistration& Registration() {
+  static base::NoDestructor<WorkerInterfaceBinderRegistration> registration;
+  return *registration;
+}
+}  // namespace
+void SetWorkerInterfaceBinderRegistration(
+    WorkerInterfaceBinderRegistration registration) {
+  Registration() = std::move(registration);
+}
+void PopulateEmbedderWorkerInterfaceBinders(
+    BrowserContext* context, const url::Origin& origin, RenderFrameHost* ancestor,
+    mojo::BinderMap* map) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (Registration())
+    Registration().Run(context, origin, ancestor, map);
+}
+}  // namespace content
