# Development build of the fork on Apple Silicon: release component build
# with DCHECKs on and no symbols, so relinks stay fast on a 16 GB machine.
# Not a distribution configuration: macOS signing requires a non-component
# build (chrome/installer/mac/signing/README.md).
target_cpu = "arm64"
is_debug = false
is_component_build = true
dcheck_always_on = true
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
# Not Google Chrome branding (Merlin's is below).
is_chrome_branded = false
# Widevine, Google's DRM module, which Chromium's component updater downloads
# after launch, and the AAC and H.264 formats that DRM sites (Spotify,
# Disney+, Prime Video) and many ordinary videos use, as Brave, Thorium and
# ungoogled-chromium ship them (decision 55). Netflix still refuses builds
# Google has not signed for Widevine's verified media path.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_widevine = true
# Merlin's name, bundle ID and icon (overlay/chrome/app/theme/merlin,
# linked in by scripts/apply_overlay.sh; patch 0004 makes the icon follow).
branding_file_path = "//chrome/app/theme/merlin/BRANDING"
# Product logos (About, version page, profile picker, menus) from
# chrome/app/theme/merlin and its sibling folders, not chromium/.
branding_path_component = "merlin"
