# Distribution build of the fork (macOS, Apple Silicon).
#
# Not the development build (build/args.modal.gn): a release needs a
# self-contained, optimized, non-component app, with symbols kept
# separately (dSYMs) for crash reports.
#
#   scripts/build_release.sh        # copies this file to out/Release/args.gn
#
# Built end to end against 159.0.8154.34 on 2026-11-28 with PGO (first
# built against 157.0.8103.26 on 2026-11-05).
target_cpu = "arm64"
is_debug = false
is_component_build = false
is_official_build = true
dcheck_always_on = false
symbol_level = 1
enable_stripping = true
# Official builds use profile-guided optimization (PGO) with Google's
# recorded profile for this Chromium version, as Chrome, Brave and Dia do;
# without it Speedometer scored about 20% lower in our measurements. The
# profile is downloaded when .gclient sets "checkout_pgo_profiles": True
# (scripts/bootstrap_chromium.sh does); scripts/build_release.sh checks it.
# Never Google Chrome branding; Merlin's comes from branding_file_path.
is_chrome_branded = false
# AAC and H.264, which many ordinary videos use, as Brave, Thorium and
# ungoogled-chromium ship them. No Widevine: unsigned builds can't play
# Netflix and similar DRM services with it, so the shell opens those sites
# in WebKit instead, which plays them with FairPlay.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_widevine = false
# Merlin's name, bundle ID and icon (overlay/chrome/app/theme/merlin,
# linked in by scripts/apply_overlay.sh; patch 0004 makes the icon follow).
branding_file_path = "//chrome/app/theme/merlin/BRANDING"
# Product logos (About, version page, menus) from chrome/app/theme/merlin
# and its sibling folders, not chromium/.
branding_path_component = "merlin"
# Lighter build. No Google test experiments: Chromium applies
# hundreds of unfinished ones to unbranded builds, among them Gemini, a
# web-based toolbar and preemptive speech-model downloads (~450 MB per
# profile). Brave and ungoogled-chromium turn them off too.
disable_fieldtrial_testing_config = true
# No remote desktop host, no Cast or printer discovery on the local network,
# no legacy hosted apps. Lens, Help me write, Gemini and background mode
# can't be compiled out of desktop Chromium; Merlin turns them off at run
# time (merlin_process_policy.h, modal_browser_controller.cc).
enable_remoting = false
enable_service_discovery = false
enable_hosted_apps = false
