{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["react", "node"],
    "baseUrl": ".",
    "paths": { "react-native": ["../../node_modules/react-native-macos"] }
  },
  "include": ["src", "../../packages/*/src"]
}
